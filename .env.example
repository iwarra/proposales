# Copy to .env.local and fill in. Never commit real values.

# Proposales (Settings → Profile). Company id from GET /v3/companies.
PROPOSALES_API_TOKEN=your-proposales-api-token
PROPOSALES_COMPANY_ID=1234
# Optional, defaults to https://api.proposales.com
# PROPOSALES_API_URL=https://api.proposales.com

LLM_PROXY_URL=https://llm-proxy.example.com
LLM_PROXY_KEY=your-llm-proxy-key
# Optional, defaults to claude-sonnet-5-5
# LLM_MODEL=claude-sonnet-5-5
# Optional: anthropic (default) or openai
# LLM_PROXY_FORMAT=anthropic

# Upstash Redis (set by Vercel's Upstash integration)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
